  ],
  "source_credit_extra": {
    "SCIENCE & HEALTH": [
      "animals",
      "digest"
    ],
    "SPACE, CLIMATE": [
      "animals",
      "digest"
    ]
  },
  "photos": {
    "providers": [
      "wikimedia",
      "inaturalist",
      "openverse"
    ],
    "licenses": [
      "cc0",
      "pd",
      "cc-by",
      "cc-by-sa"
    ],
    "min_width": 1200,
    "prefer_aspect": [
      1.2,
      1.9
    ],
    "caption_template": "{description}. Photo: {creator}, {license_link}, via {provider} ({page_url}); resized and recompressed for this briefing"
  },
  "conductor": {
    "slate_candidates": 14,
    "digest_items": 6,
    "max_parallel_articles": 2,
    "review_enabled": false,
    "models": {
      "classify": {
        "model": "haiku",
        "effort": "low"
      },
      "slate": {
        "model": "opus",
        "effort": "medium"
      },
      "article": {
        "model": "sonnet",
        "effort": "medium"
      },
      "repair": {
        "model": "sonnet",
        "effort": "low"
      },
      "header": {
        "model": "sonnet",
        "effort": "low"
      },
      "digest": {
        "model": "sonnet",
        "effort": "low"
      },
      "review": {
        "model": "claude-fable-5-1",
        "effort": "medium",
        "optional": true,
        "fallback": "opus"
      }
    },
    "budget": {
      "max_cost_usd_per_run": 40.0,
      "max_cost_usd_per_article": 4.0
    },
    "delivery": {
      "standalone": false,
      "held_for": "daily",
      "subject_template": "The Animal Science Briefing - {human_date}",
      "recipients_env": "ANIMAL_BRIEFING_RECIPIENTS",
      "extra_recipients_env": "ANIMAL_BRIEFING_EXTRA_RECIPIENTS"
    },
    "article_sections": [
      "animals",
      "humaninterest"
    ],
    "fill_sections": {
      "humaninterest": "animals"
    },
    "fill_reserves": 4,
    "skip_low_confidence": true,
    "section_briefs": {
      "animals": "Animal science for an expert reader: findings, status decisions, disease events and methods, each built on a primary document.",
      "humaninterest": "Human interest, used only to fill a gap left by animal-science stories that could not be written with confidence: people and animals - field researchers and their long-term study animals, wildlife rehabilitators, keepers, rangers, communities and citizen scientists living with or protecting wildlife. A real person or place, a real sequence of events, named sources; warm but not sentimental. Never animal cruelty or harm as the subject, never pets-and-celebrities, never viral clips."
    },
    "strip_unread_mentions": true
  }
}
