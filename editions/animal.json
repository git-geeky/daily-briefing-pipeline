    "red list",
    "karyotype",
    "microbiome",
    "transcriptom",
    "heritabilit",
    "demograph",
    "dispersal",
    "foraging"
  ],
  "technical_sections": [
    "animals"
  ],
  "catalogs": [
    "sources.md",
    "animal-sources.md"
  ],
  "catalog_include_buckets": [
    "ANIMAL",
    "WIRE SERVICES",
    "AGGREGATORS",
    "SCIENCE & HEALTH",
    "SPACE, CLIMATE",
    "NATIVE-LANGUAGE",
    "AFRICA",
    "LATIN AMERICA",
    "SOUTH & SOUTHEAST ASIA",
